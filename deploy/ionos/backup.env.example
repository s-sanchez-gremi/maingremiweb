# /srv/apex/production/backup.env (chmod 600). Uses its own S3 keys and its own PRIVATE bucket.
DATABASE_URL=postgres://apex_app:CHANGE@10.0.0.10:5432/apex?sslmode=require
BACKUP_S3_ENDPOINT=https://s3-eu-south-2.ionoscloud.com
BACKUP_S3_REGION=eu-south-2
BACKUP_BUCKET=yourprefix-apex-backups
BACKUP_ACCESS_KEY=CHANGE
BACKUP_SECRET_KEY=CHANGE
BACKUP_PASSPHRASE=CHANGE          # openssl rand -hex 32  -- STORE A COPY OUTSIDE THIS SERVER: without it the backups are unreadable
RETENTION_DAYS=30
# Optional dead-man's switch (Healthchecks.io or similar): alerts you when a backup does NOT run or fails
# BACKUP_PING_URL=https://hc-ping.com/your-uuid
# DRILL_PING_URL=https://hc-ping.com/your-other-uuid
