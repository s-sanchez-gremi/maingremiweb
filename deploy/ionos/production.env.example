# Copy to /srv/apex/production/.env on the server (chmod 600) and fill in. NEVER commit the real file.
# Generate each secret separately:  openssl rand -hex 32
APEX_ENV=production
APEX_IMAGE=ghcr.io/OWNER/REPO          # the image the release workflow publishes (lowercase)
SITE_DOMAIN=www.example.com            # the public host name (DNS A record -> this server); Caddy gets the certificate for it

APP_ENV=production
NODE_ENV=production
SITE_URL=https://www.example.com

# IONOS Managed PostgreSQL: use the PRIVATE address of the cluster and keep ?sslmode=require
DATABASE_URL=postgres://apex_app:CHANGE@10.0.0.10:5432/apex?sslmode=require

# IONOS S3 Object Storage (bucket names are global: prefix them). Pick the region you created the buckets in:
#   Frankfurt  endpoint https://s3-eu-central-1.ionoscloud.com   region de
#   Berlin     endpoint https://s3-eu-central-2.ionoscloud.com   region eu-central-2
#   Logroño    endpoint https://s3-eu-south-2.ionoscloud.com     region eu-south-2
S3_ENDPOINT=https://s3-eu-south-2.ionoscloud.com
S3_REGION=eu-south-2
S3_ACCESS_KEY=CHANGE
S3_SECRET_KEY=CHANGE
S3_BUCKET=yourprefix-apex-media                 # public-read (see media-bucket-policy.json)
S3_PRIVATE_BUCKET=yourprefix-apex-private       # visitor uploads: NEVER public
S3_PUBLIC_URL=https://s3-eu-south-2.ionoscloud.com/yourprefix-apex-media
# S3_FORCE_PATH_STYLE=0                         # only if IONOS turns out to require bucket-name hosts

# Mail (IONOS mailbox): check host/port in your IONOS mail settings; the user name is the full address, URL-encoded (@ -> %40)
SMTP_URL=smtp://no-reply%40example.com:CHANGE@smtp.ionos.es:587/?requireTLS=true
MAIL_FROM=Apex <no-reply@example.com>
STAFF_NOTIFY_EMAIL=info@example.com

CRON_SECRET=CHANGE
BOT_SECRET=CHANGE
TRUSTED_PROXY_HOPS=1

# First start on a NEW installation only, then delete these two lines and redeploy:
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
