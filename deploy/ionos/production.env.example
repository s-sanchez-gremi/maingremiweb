# Copy to /srv/apex/production/.env on the server (chmod 600) and fill in. NEVER commit the real file.
# Generate each secret separately:  openssl rand -hex 32
APEX_ENV=production
APEX_IMAGE=ghcr.io/OWNER/REPO          # the image the release workflow publishes (lowercase)
# Who may open the admins and the website's staff endpoints (space-separated addresses or ranges: office, VPN). EMPTY = NOBODY, nobody can log in.
ADMIN_ALLOWED_IPS=
CRM_DOMAIN=crm.example.com               # the CRM app host (its own DNS A record -> this server and its own certificate)
ADMIN_DOMAIN=admin.example.com           # the CMS admin host (its own DNS A record and certificate too)
HUB_DOMAIN=hub.example.com               # the Hub start page host (links to every portal; own DNS A record -> this server and its own certificate)
FORMS_DOMAIN=forms.example.com             # the Forms app host (builder, responses; own DNS A record -> this server and its own certificate)
SITE_DOMAIN=www.example.com            # the public host name (DNS A record -> this server); Caddy gets the certificate for it

APP_ENV=production
NODE_ENV=production
# How the apps find each other (inside the Docker network, and in links):
WEB_INTERNAL_URL=http://web:3000      # the CMS admin, the Forms app and the CRM app ask the website to refresh its cache after a change (uses CRON_SECRET)
CRM_URL=https://crm.example.com       # menu link in the CMS admin and the Forms app
SIGN_URL=                            # e-signature portal address (the Hub reads ADMIN_URL, CRM_URL, FORMS_URL, SITE_URL and this) (empty until one exists: the Hub shows "coming soon")
FORMS_URL=https://forms.example.com   # menu link in the CRM app, and where staff notification emails point for new responses
WEB_ADMIN_URL=https://admin.example.com # menu link in the CRM and Forms apps (the CMS admin)
ADMIN_URL=https://admin.example.com   # the website's staff bar links here
WEB_PREVIEW_URL=https://www.example.com # the CMS editor shows the website's live preview from here
SESSION_COOKIE_DOMAIN=example.com     # web AND admin: the staff session is shared between www. and admin. (NOT used by the CRM or Forms apps)
# One restricted database user per app (db/grants.sql, DEPLOY.md "Database users per app"): DATABASE_URL_WEB=…, DATABASE_URL_ADMIN=…, DATABASE_URL_CRM=… and DATABASE_URL_FORMS=… override
# DATABASE_URL. If you use them, REMOVE DATABASE_URL below from this file (the apps load all of it) and put the owner's URL in .env.migrate as MIGRATE_DATABASE_URL.
SITE_URL=https://www.example.com

# IONOS Managed PostgreSQL: use the PRIVATE address of the cluster and keep ?sslmode=require
DATABASE_URL=postgres://apex_app:CHANGE@10.0.0.10:5432/apex?sslmode=require

# IONOS S3 Object Storage (bucket names are global: prefix them). Pick the region you created the buckets in:
#   Frankfurt  endpoint https://s3-eu-central-1.ionoscloud.com   region de
#   Berlin     endpoint https://s3-eu-central-2.ionoscloud.com   region eu-central-2
#   Logroño    endpoint https://s3-eu-south-2.ionoscloud.com     region eu-south-2
S3_ENDPOINT=https://s3-eu-south-2.ionoscloud.com
S3_REGION=eu-south-2
S3_ACCESS_KEY=CHANGE
S3_SECRET_KEY=CHANGE
S3_BUCKET=yourprefix-apex-media                 # public-read (see media-bucket-policy.json)
S3_PRIVATE_BUCKET=yourprefix-apex-private       # visitor uploads: NEVER public
S3_PUBLIC_URL=https://s3-eu-south-2.ionoscloud.com/yourprefix-apex-media
# S3_FORCE_PATH_STYLE=0                         # only if IONOS turns out to require bucket-name hosts

# Mail (IONOS mailbox): check host/port in your IONOS mail settings; the user name is the full address, URL-encoded (@ -> %40)
SMTP_URL=smtp://no-reply%40example.com:CHANGE@smtp.ionos.es:587/?requireTLS=true
MAIL_FROM=Apex <no-reply@example.com>
# Where new-error alerts go (optional; errors are always logged in the admin)
ALERT_EMAIL=
STAFF_NOTIFY_EMAIL=info@example.com

CRON_SECRET=CHANGE
BOT_SECRET=CHANGE
TRUSTED_PROXY_HOPS=1

# First start on a NEW installation only, then delete these two lines and redeploy:
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
