# /srv/apex/staging/.env on the STAGING server (chmod 600). Staging = small server + PostgreSQL in Docker (compose.staging.yml).
# Staging must hold NO real personal data: use test data only.
APEX_ENV=apex-staging
APEX_IMAGE=ghcr.io/OWNER/REPO
# Who may open /admin and uploads (space-separated addresses or ranges: office, VPN). EMPTY = NOBODY, nobody can log in.
ADMIN_ALLOWED_IPS=
CRM_DOMAIN=crm.example.com               # the CRM app host (its own DNS A record -> this server and its own certificate)
ADMIN_DOMAIN=admin.staging.example.com   # the CMS admin host (its own DNS A record and certificate too)
HUB_DOMAIN=hub.example.com               # the Hub start page host (links to every portal; own DNS A record -> this server and its own certificate)
FORMS_DOMAIN=forms.example.com             # the Forms app host (builder, responses; own DNS A record -> this server and its own certificate)
SITE_DOMAIN=staging.example.com            # DNS A record -> the staging server

# The database container (used by compose.staging.yml) ...
POSTGRES_USER=apex_staging
POSTGRES_PASSWORD=CHANGE                   # openssl rand -hex 24
POSTGRES_DB=apex_staging

APP_ENV=staging
NODE_ENV=production
# How the two apps find each other (inside the Docker network, and in menu links):
WEB_INTERNAL_URL=http://web:3000      # the CMS admin, the Forms app and the CRM app ask the website to refresh its cache after a change (uses CRON_SECRET)
CRM_URL=https://crm.example.com       # menu link in the CMS admin and the Forms app
SIGN_URL=                            # e-signature portal address (the Hub reads ADMIN_URL, CRM_URL, FORMS_URL, SITE_URL and this) (empty until one exists: the Hub shows "coming soon")
HUB_URL=https://hub.example.com         # "Totes les eines" link in the menus of the CMS admin, CRM and Forms apps (empty = no link)
FORMS_URL=https://forms.example.com   # menu link in the CRM app, and where staff notification emails point for new responses
WEB_ADMIN_URL=https://admin.staging.example.com # menu link in the CRM and Forms apps (the CMS admin)
ADMIN_URL=https://admin.staging.example.com   # the website's staff bar links here
WEB_PREVIEW_URL=https://staging.example.com   # the CMS editor shows the website's live preview from here
SESSION_COOKIE_DOMAIN=staging.example.com     # web AND admin share the staff session (NOT used by the CRM or Forms apps)
# One database user per app (optional until docs/split-plan.md step S4): DATABASE_URL_WEB=…, DATABASE_URL_ADMIN=…, DATABASE_URL_CRM=… and DATABASE_URL_FORMS=… override DATABASE_URL.
SITE_URL=https://staging.example.com
# ... and the app's connection to it (same credentials; host "db" is the container; no TLS needed inside the private Docker network)
DATABASE_URL=postgres://apex_staging:CHANGE@db:5432/apex_staging

# S3 in Logroño (use SEPARATE buckets from production so staging can never touch real files)
S3_ENDPOINT=https://s3-eu-south-2.ionoscloud.com
S3_REGION=eu-south-2
S3_ACCESS_KEY=CHANGE
S3_SECRET_KEY=CHANGE
S3_BUCKET=yourprefix-apex-staging-media
S3_PRIVATE_BUCKET=yourprefix-apex-staging-private
S3_PUBLIC_URL=https://s3-eu-south-2.ionoscloud.com/yourprefix-apex-staging-media

SMTP_URL=smtp://no-reply%40example.com:CHANGE@smtp.ionos.es:587/?requireTLS=true
MAIL_FROM=Apex STAGING <no-reply@example.com>
# Where new-error alerts go (optional; errors are always logged in the admin)
ALERT_EMAIL=
STAFF_NOTIFY_EMAIL=you@example.com          # where staging form e-mails go: NOT the real staff inbox

CRON_SECRET=CHANGE
BOT_SECRET=CHANGE
TRUSTED_PROXY_HOPS=1
AUTO_MIGRATE=0
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
