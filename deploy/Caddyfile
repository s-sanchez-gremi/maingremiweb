# HTTPS certificates are obtained and renewed automatically (the domain's DNS must already point at this server).
{$SITE_DOMAIN} {
	encode zstd gzip
	# Staff-only: the admin screens (CRM, projects, settings...) and the upload endpoint answer 404 to everyone outside
	# ADMIN_ALLOWED_IPS (space-separated addresses/CIDRs, e.g. "203.0.113.7 198.51.100.0/24", or your VPN's range).
	# Unset/empty = nobody can reach them (fails closed). The login still applies on top. Caddy is the edge, so remote_ip
	# is the real visitor. Public pages, form submissions and the health check stay open.
	@staff_outside {
		path /admin /admin/* /api/media /api/media/*
		not remote_ip {$ADMIN_ALLOWED_IPS:127.0.0.1/32}
	}
	respond @staff_outside 404
	# Caddy appends the real client address to X-Forwarded-For and drops anything a visitor sent: matches TRUSTED_PROXY_HOPS=1.
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
# "www" goes to the canonical address.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
