#!/usr/bin/env bash
# Nobody pushes straight to main: work on a branch and open a pull request (see CONTRIBUTING.md).
# Emergency only: ALLOW_MAIN_PUSH=1 git push
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
    echo "Blocked: push to main. Create a branch (git switch -c feat/your-change), push it and open a pull request." >&2
    exit 1
  fi
done
exit 0
