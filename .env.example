# Copy to .env (local) — each environment has its own values; never commit real secrets.
APP_ENV=local
DATABASE_URL=postgres://apex:apex@localhost:5432/apex
S3_ENDPOINT=http://localhost:9090
S3_REGION=eu-west-1
S3_BUCKET=apex-media
S3_ACCESS_KEY=apex
S3_SECRET_KEY=apexapexapex
SMTP_URL=smtp://localhost:1025
CRON_SECRET=change-me
S3_PUBLIC_URL=http://localhost:9090/apex-media
SITE_URL=http://localhost:3000
S3_PRIVATE_BUCKET=apex-private
MAIL_FROM=Apex <no-reply@apex.example>
# Where new-error alerts go (optional; errors are always logged in the admin)
ALERT_EMAIL=
STAFF_NOTIFY_EMAIL=staff@apex.example
BOT_SECRET=change-me
TRUSTED_PROXY_HOPS=1
# First start on a NEW server only (see DEPLOY.md), then remove:
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# ---- The two apps talk to each other only through these (local defaults; production values: see DEPLOY.md) ----
# Website (3000) forwards the public form API to the CRM app (3001) when this is set (development and tests; in production Caddy routes it).
CRM_INTERNAL_URL=http://localhost:3001
# The CRM app asks the website to refresh its cache after a form changes (uses CRON_SECRET above as the shared secret).
WEB_INTERNAL_URL=http://localhost:3000
# Menu links between the two admins
CRM_URL=http://localhost:3001
WEB_ADMIN_URL=http://localhost:3000

# Notion import (docs/notion-import.md): only needed on the machine that runs `pnpm --filter crm notion:import`
# NOTION_TOKEN=
# NOTION_DB_COMPANIES=
# NOTION_DB_GALA=
# NOTION_DB_VISITS=
# NOTION_DB_LABOUR=
# NOTION_DB_TRAINING=
# NOTION_DB_SPONSORS=
# NOTION_DB_JOBSEEKERS=
