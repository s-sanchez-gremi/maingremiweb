# Copy to .env (local) — each environment has its own values; never commit real secrets.
APP_ENV=local
DATABASE_URL=postgres://apex:apex@localhost:5432/apex
S3_ENDPOINT=http://localhost:9090
S3_REGION=eu-west-1
S3_BUCKET=apex-media
S3_ACCESS_KEY=apex
S3_SECRET_KEY=apexapexapex
SMTP_URL=smtp://localhost:1025
CRON_SECRET=change-me
S3_PUBLIC_URL=http://localhost:9090/apex-media
SITE_URL=http://localhost:3000
S3_PRIVATE_BUCKET=apex-private
MAIL_FROM=Apex <no-reply@apex.example>
# Where new-error alerts go (optional; errors are always logged in the admin)
ALERT_EMAIL=
STAFF_NOTIFY_EMAIL=staff@apex.example
BOT_SECRET=change-me
# The Signatures app: the key that turns a signer's address into the hash kept in the audit trail (a real random value in staging/production)
SIGN_SECRET=change-me
TRUSTED_PROXY_HOPS=1
# First start on a NEW server only (see DEPLOY.md), then remove:
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# ---- The apps talk to each other only through these (local defaults; production values: see DEPLOY.md) ----
# Ports in development: website 3000, CRM 3001, forms 3002, CMS admin 3003, signatures 3004, hub 3005. Behind Caddy in production each is reached on its own host.
# Website (3000) forwards the public form API to the Forms app (3002) when this is set (development and tests; in production Caddy routes it).
FORMS_INTERNAL_URL=http://localhost:3002
# The Forms app and the CMS admin (and the CRM) ask the website to refresh its cache after a change (uses CRON_SECRET above as the shared secret).
WEB_INTERNAL_URL=http://localhost:3000
# Menu links between the apps (WEB_ADMIN_URL is where the CMS admin runs), and the address staff emails link to for new responses
CRM_URL=http://localhost:3001
FORMS_URL=http://localhost:3002
SIGN_URL=http://localhost:3004
WEB_ADMIN_URL=http://localhost:3003
# Website -> admin: where the staff bar links to (empty behind Caddy: same address). The website serves the editor's live preview, so the admin needs to know where it is.
ADMIN_URL=http://localhost:3003
WEB_PREVIEW_URL=http://localhost:3000
# Hub (start page linking every portal, port 3005): it reads ADMIN_URL, CRM_URL, FORMS_URL, SIGN_URL and SITE_URL above; a portal whose address is empty shows "coming soon" / "not configured".

# Notion import (docs/notion-import.md): only needed on the machine that runs `pnpm --filter crm notion:import`
# NOTION_TOKEN=
# NOTION_DB_COMPANIES=
# NOTION_DB_FORMER=
# NOTION_DB_EXTERNAL=
# NOTION_DB_GALA=
# NOTION_DB_VISITS=
# NOTION_DB_LABOUR=
# NOTION_DB_TRAINING=
# NOTION_DB_SPONSORS=
# NOTION_DB_JOBSEEKERS=
